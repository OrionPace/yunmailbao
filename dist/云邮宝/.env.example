# Email Sender Configuration
# Replace these with real credentials in the .env file

SMTP_SERVER_QQ=smtp.qq.com
SMTP_PORT_QQ=587
SMTP_SERVER_163=smtp.163.com
SMTP_PORT_163=25

# Add your accounts here. You can add more format by numbering.
ACCOUNT_1_EMAIL=your_email@qq.com
ACCOUNT_1_PASSWORD=your_password_or_auth_code
ACCOUNT_1_NAME=广东省公共卫生研究院

ACCOUNT_2_EMAIL=another_email@163.com
ACCOUNT_2_PASSWORD=your_password_or_auth_code
ACCOUNT_2_NAME=广东省公共卫生研究院
